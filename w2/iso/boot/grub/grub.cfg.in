set timeout=5
set default=@FB_DEFAULT@

insmod vbe
insmod video_bochs
insmod video_cirrus
insmod video
insmod gfxterm
set gfxmode=1024x768x32

serial --speed=115200 --unit=0
terminal_input serial console
terminal_output serial console

menuentry "OS2 text" {
    echo "Loading OS2 text mode..."
    set gfxpayload=text
    multiboot /boot/kernel.elf
    boot
}

menuentry "OS2 framebuffer" {
    echo "Loading OS2 1024x768x32 framebuffer..."
    terminal_output gfxterm
    set gfxpayload=1024x768x32
    multiboot /boot/kernel.elf
    boot
}
